# Copy to .env (never commit .env). Fill AT LEAST ONE key; the first one found is used
# in this order: OpenAI -> OpenRouter -> Gemini -> Anthropic. Anthropic is chat-only
# (no embedding API), so with only ANTHROPIC_API_KEY you also need one of the other three for embeddings.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=

# Optional: force a provider instead of the order above
# LLM_PROVIDER=openai          # openai | openrouter | gemini | anthropic | opencode
# EMBEDDING_PROVIDER=openai    # openai | openrouter | gemini
# OpenCode Zen is OpenAI-compatible but has NO embeddings endpoint: use it for chat only
# (e.g. LLM_PROVIDER=opencode + EMBEDDING_PROVIDER=openrouter). Base URL defaults to
# https://opencode.ai/zen/v1 and can be overridden with OPENCODE_BASE_URL.

# Optional: override default models (<PROVIDER>_CHAT_MODEL / <PROVIDER>_EMBEDDING_MODEL)
# OPENCODE_CHAT_MODEL=deepseek-v4.1-flash      # any Zen model that uses /chat/completions
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Must match NEO4J_AUTH used in `docker run`
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
